<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign Up - Agriksense</title>
<meta name="description" content="Create your Agriksense account. Join the agricultural intelligence infrastructure for Africa.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css">
<link rel="stylesheet" href="css/auth.css">
</head>
<body>

<nav class="nav auth-nav" id="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/"><img class="brand-logo" src="images/logo/logo-dark.png" alt="Agriksense"></a>
    <div class="nav-links">
      <a href="/#platform">Platform</a><a href="/#network">Network</a><a href="/#field">Field</a><a href="/#credit">Credit</a><a href="/dashboard">Dashboard</a>
    </div>
    <a class="nav-contact" href="/login">Login</a>
    <a class="nav-cta" href="/signup">Sign up ↗</a>
    <button class="mobile-menu" aria-label="menu">☰</button>
  </div>
</nav>

<div class="mobile-nav" id="mobileNav">
  <div class="mobile-nav-inner">
    <a href="/dashboard">Platform</a>
    <a href="/farmers">Network</a>
    <a href="/farms">Field</a>
    <a href="/agriscore">Credit</a>
    <a href="/login" style="margin-top:20px;color:var(--lime)">Login</a>
    <a href="/signup" style="color:var(--lime)">Sign up</a>
  </div>
  <button class="mobile-nav-close" aria-label="close menu">✕</button>
</div>

<main class="auth-main">
  <div class="auth-container">
    <div class="auth-visual">
      <div class="auth-visual-content">
        <div class="auth-logo"><img src="images/logo/logo-tile.png" alt="Agriksense" class="brand-logo-mark"></div>
        <h1>Start your agricultural<br>intelligence journey</h1>
        <p>Join operators, cooperatives, and financial institutions building the future of precision agriculture across Sub-Saharan Africa.</p>
        <div class="auth-features">
          <div class="auth-feature">
            <div class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <span>Verified farm identity & records</span>
          </div>
          <div class="auth-feature">
            <div class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <span>0-1000 AgriScore credit index</span>
          </div>
          <div class="auth-feature">
            <div class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <span>Field telemetry & aerial vision</span>
          </div>
        </div>
        <div class="auth-trust">
          <p class="trust-text">Trusted by agricultural operations across Nigeria</p>
        </div>
      </div>
      <div class="auth-visual-bg"></div>
    </div>

    <div class="auth-form-panel">
      <div class="auth-form-wrap">
        <div class="auth-header">
          <h2>Create your account</h2>
          <p>Get started with Agriksense today</p>
        </div>

        <form class="auth-form" action="#" method="post">
          <div class="form-group">
            <label>Account type</label>
            <div class="role-selector" role="radiogroup" aria-label="Account type">
              <button type="button" class="role-tab active" data-role="farmer">
                <span class="role-tab-title">Farmer</span>
                <span class="role-tab-sub">I grow crops or rear livestock</span>
              </button>
              <button type="button" class="role-tab" data-role="dco">
                <span class="role-tab-title">Officer</span>
                <span class="role-tab-sub">I collect field data</span>
              </button>
              <button type="button" class="role-tab" data-role="organization">
                <span class="role-tab-title">Organization</span>
                <span class="role-tab-sub">A company or cooperative</span>
              </button>
            </div>
            <input type="hidden" name="role" value="farmer">
          </div>

          <div data-role-panel="farmer">
            <div class="form-row">
              <div class="form-group">
                <label for="f-first-name">First name</label>
                <input type="text" id="f-first-name" name="first_name" placeholder="John" required autocomplete="given-name">
              </div>
              <div class="form-group">
                <label for="f-last-name">Last name</label>
                <input type="text" id="f-last-name" name="last_name" placeholder="Doe" required autocomplete="family-name">
              </div>
            </div>
            <div class="form-group">
              <label for="f-other-name">Other name</label>
              <input type="text" id="f-other-name" name="other_name" placeholder="Optional">
            </div>
            <div class="form-group">
              <label for="f-phone">WhatsApp phone number</label>
              <input type="tel" id="f-phone" name="phone" placeholder="+2348..." required autocomplete="tel">
            </div>
            <div class="form-group">
              <label for="f-email">Email address</label>
              <input type="email" id="f-email" name="email" placeholder="you@example.com">
              <span class="input-hint">Used only for account recovery</span>
            </div>
            <div class="form-group">
              <label for="f-password">Password</label>
              <input type="password" id="f-password" name="password" placeholder="Create a strong password" required autocomplete="new-password">
              <span class="input-hint">Must be at least 6 characters</span>
            </div>
            <div class="form-group">
              <label for="f-confirm-password">Confirm password</label>
              <input type="password" id="f-confirm-password" name="confirm_password" placeholder="Repeat your password" required autocomplete="new-password">
            </div>
            <div class="form-group">
              <label class="checkbox-label">
                <input type="checkbox" name="consent">
                <span>I accept the Farmer Informed Consent terms for data collection and verification.</span>
              </label>
            </div>
          </div>

          <div data-role-panel="dco" hidden>
            <div class="form-row">
              <div class="form-group">
                <label for="dco-first-name">First name</label>
                <input type="text" id="dco-first-name" name="first_name" placeholder="Ada" required autocomplete="given-name">
              </div>
              <div class="form-group">
                <label for="dco-last-name">Last name</label>
                <input type="text" id="dco-last-name" name="last_name" placeholder="Okafor" required autocomplete="family-name">
              </div>
            </div>
            <div class="form-group">
              <label for="dco-other-name">Other name</label>
              <input type="text" id="dco-other-name" name="other_name" placeholder="Optional">
            </div>
            <div class="form-group">
              <label for="dco-email">Email address</label>
              <input type="email" id="dco-email" name="email" placeholder="you@company.com" required autocomplete="email">
            </div>
            <div class="form-group">
              <label for="dco-phone">WhatsApp phone number</label>
              <input type="tel" id="dco-phone" name="phone" placeholder="+2348..." required autocomplete="tel">
            </div>
            <div class="form-group">
              <label for="dco-password">Password</label>
              <input type="password" id="dco-password" name="password" placeholder="Create a strong password" required autocomplete="new-password">
              <span class="input-hint">Must be at least 6 characters</span>
            </div>
            <div class="form-group">
              <label for="dco-confirm-password">Confirm password</label>
              <input type="password" id="dco-confirm-password" name="confirm_password" placeholder="Repeat your password" required autocomplete="new-password">
            </div>
          </div>

          <div data-role-panel="organization" hidden>
            <div class="form-group">
              <label for="org-org-name">Organization name</label>
              <input type="text" id="org-org-name" name="org_name" placeholder="Your company or cooperative" required autocomplete="organization">
            </div>
            <div class="form-group">
              <label for="org-email">Work email address</label>
              <input type="email" id="org-email" name="email" placeholder="you@company.com" required autocomplete="email">
            </div>
            <div class="form-group">
              <label for="org-phone">Phone number</label>
              <input type="tel" id="org-phone" name="phone" placeholder="+2348...">
            </div>
            <div class="form-group">
              <label for="org-password">Password</label>
              <input type="password" id="org-password" name="password" placeholder="Create a strong password" required autocomplete="new-password">
              <span class="input-hint">Must be at least 6 characters</span>
            </div>
            <div class="form-group">
              <label for="org-confirm-password">Confirm password</label>
              <input type="password" id="org-confirm-password" name="confirm_password" placeholder="Repeat your password" required autocomplete="new-password">
            </div>
          </div>

          <button type="submit" class="btn-submit">Create account</button>
        </form>

        <div class="auth-footer">
          <p>Already have an account? <a href="/login">Log in</a></p>
        </div>
      </div>
    </div>
  </div>
</main>

<script src="js/main.js"></script>
<script src="js/auth.js"></script>
</body>
</html>
