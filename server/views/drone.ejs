<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Drone Monitoring' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'drone' }) %>
  <div class="main">
    <%- include('partials/topbar', { title: 'Drone Monitoring' }) %>
    <div class="content">
      <section class="kpis">
        <div class="kpi-card">
          <small>Active drones</small>
          <strong>3 of 4</strong>
          <span>1 on charge</span>
        </div>
        <div class="kpi-card">
          <small>Area scanned</small>
          <strong>312</strong>
          <span>ha this week</span>
        </div>
        <div class="kpi-card">
          <small>NDVI coverage</small>
          <strong>81%</strong>
          <span>of active farms</span>
        </div>
        <div class="kpi-card">
          <small>Flies scheduled</small>
          <strong>14</strong>
          <span class="amber">3 for review</span>
        </div>
      </section>

      <section class="grid-2">
        <div class="card">
          <div class="card-head">
            <div>
              <b>Flight schedule</b>
              <div class="sub">Upcoming drone missions across clusters</div>
            </div>
          </div>
          <div class="table-wrap"><table class="table">
            <thead>
              <tr>
                <th>Mission</th>
                <th>Cluster</th>
                <th>Area</th>
                <th>Time</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>NDVI scan</b><small>MAV21</small></td>
                <td>Maize belt</td>
                <td>18 ha</td>
                <td>08:00</td>
                <td><span class="tag green">Done</span></td>
              </tr>
              <tr>
                <td><b>NDVI scan</b><small>MAV21</small></td>
                <td>Rice cluster</td>
                <td>12 ha</td>
                <td>09:30</td>
                <td><span class="tag green">Done</span></td>
              </tr>
              <tr>
                <td><b>Pest survey</b><small>MAV20</small></td>
                <td>Tomato farms</td>
                <td>11 ha</td>
                <td>11:00</td>
                <td><span class="tag blue">Flying</span></td>
              </tr>
              <tr>
                <td><b>Irrigation check</b><small>MAV18</small></td>
                <td>Rice cluster</td>
                <td>9 ha</td>
                <td>14:45</td>
                <td><span class="tag amber">Queued</span></td>
              </tr>
              <tr>
                <td><b>Salt stress scan</b><small>MAV22</small></td>
                <td>Beans block</td>
                <td>8 ha</td>
                <td>16:20</td>
                <td><span class="tag amber">Queued</span></td>
              </tr>
            </tbody>
          </table></div>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <b>NDVI coverage</b>
              <div class="sub">Vegetation health scans completed per crop</div>
            </div>
          </div>
          <div class="dev-kpis">
            <div class="dev"><b>81%</b><span>Overall</span></div>
            <div class="dev"><b>24</b><span>Scans</span></div>
            <div class="dev"><b>4.2</b><span>Avg flights/wk</span></div>
          </div>
          <div class="list">
            <div class="item"><span><i class="dot green"></i>Maize</span><div class="progress"><i style="width:88%"></i></div><b>88%</b></div>
            <div class="item"><span><i class="dot green"></i>Rice</span><div class="progress"><i style="width:76%"></i></div><b>76%</b></div>
            <div class="item"><span><i class="dot amber"></i>Tomato</span><div class="progress"><i style="width:58%"></i></div><b>58%</b></div>
            <div class="item"><span><i class="dot amber"></i>Beans</span><div class="progress"><i style="width:52%"></i></div><b>52%</b></div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
</body>
</html>