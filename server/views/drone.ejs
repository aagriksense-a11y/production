<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Drone Monitoring' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'drone' }) %>
  <div class="main">
    <%- include('partials/topbar', { title: 'Drone Monitoring' }) %>
    <div class="content">
      <section class="kpis">
        <div class="kpi-card"><small>Flights this week</small><strong>18</strong><span>2 live now</span></div>
        <div class="kpi-card"><small>Fields scanned</small><strong>28/42</strong><span>▲ 6 this week</span></div>
        <div class="kpi-card"><small>Stress alerts</small><strong>03</strong><span class="amber">1 high priority</span></div>
        <div class="kpi-card"><small>Reports generated</small><strong>06</strong><span>Shared with farmers</span></div>
      </section>

      <section class="grid-2">
        <div class="card">
          <div class="card-head">
            <div>
              <b>Flight schedule</b>
              <div class="sub">Aerial monitoring missions across field clusters</div>
            </div>
            <div class="select">This week ▾</div>
          </div>
          <table class="table">
            <thead>
              <tr>
                <th>Flight</th>
                <th>Field</th>
                <th>Payload</th>
                <th>Time</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>FL-2044</b><br><small>Drone DX-03</small></td>
                <td>Block B · Chidi Okeke</td>
                <td>NDVI</td>
                <td>Today 3:12 PM</td>
                <td><span class="tag green">Live</span></td>
              </tr>
              <tr>
                <td><b>FL-2043</b><br><small>Drone DX-01</small></td>
                <td>Block A · Amina Yusuf</td>
                <td>RGB</td>
                <td>Today 2:05 PM</td>
                <td><span class="tag blue">Completed</span></td>
              </tr>
              <tr>
                <td><b>FL-2042</b><br><small>Drone DX-02</small></td>
                <td>Block C · Fatima Bello</td>
                <td>NDVI</td>
                <td>Today 11:40 AM</td>
                <td><span class="tag amber">Processing</span></td>
              </tr>
              <tr>
                <td><b>FL-2041</b><br><small>Drone DX-01</small></td>
                <td>Block D · Ibrahim Musa</td>
                <td>Multispectral</td>
                <td>Yesterday 4:10 PM</td>
                <td><span class="tag gray">Scheduled</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <b>NDVI coverage</b>
              <div class="sub">Vegetation health across scanned fields</div>
            </div>
          </div>
          <div class="dev-kpis">
            <div><strong>0.68</strong><small>Avg NDVI</small></div>
            <div><strong>28</strong><small>Fields scanned</small></div>
          </div>
          <div class="seg seg-lg"><i class="a"></i><i class="b"></i><i class="c"></i></div>
          <div class="legend">
            <span><i style="background:#0b5b3e"></i>Healthy 58%</span>
            <span><i style="background:#d5f17f"></i>Moderate 34%</span>
            <span><i style="background:#d8693f"></i>Stressed 8%</span>
          </div>
          <div class="list">
            <div class="i"><span>Canopy stress scan</span><span class="status-live">In progress</span></div>
            <div class="i"><span>Irrigation gap report</span><span class="status-wait">Queued</span></div>
            <div class="i"><span>Soil baseline mapping</span><span class="status-done">Completed</span></div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
</body>
</html>