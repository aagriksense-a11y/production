<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Dashboard' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'dashboard' }) %>
  <div class="main">
    <%- include('partials/topbar', { title: 'Operations dashboard' }) %>
    <div class="content">
      <div id="loading" class="card">Loading platform data…</div>

      <section class="kpis" id="kpis" style="display:none"></section>

      <section class="grid-2" id="chartRow" style="display:none">
        <div class="card">
          <div class="card-head">
            <div>
              <b>New farmer signups</b>
              <div class="sub">Daily registrations over the last 7 days</div>
            </div>
          </div>
          <div class="bar-chart" id="signupBars"></div>
        </div>
        <div class="card">
          <div class="card-head">
            <div>
              <b>Field health mix</b>
              <div class="sub">Health classification across monitored plots</div>
            </div>
          </div>
          <div class="donut" id="healthDonut"></div>
          <div class="legend" id="healthLegend"></div>
        </div>
      </section>

      <section class="grid-3" id="networkRow" style="display:none">
        <div class="card span-2">
          <div class="card-head">
            <div>
              <b>Farm & plot network</b>
              <div class="sub">Recent farms with live moisture and credit band</div>
            </div>
          </div>
          <div class="table-wrap"><table class="table">
            <thead>
              <tr>
                <th>Farm</th>
                <th>Farmer</th>
                <th>Moisture</th>
                <th>Stress</th>
                <th>AgriScore</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="networkRows"></tbody>
          </table></div>
        </div>
        <div class="card">
          <b>Network snapshot</b>
          <div class="mini"><span>Online sensors</span><b id="snapSensors"></b></div>
          <div class="mini"><span>Mapped plots</span><b id="snapMapped"></b></div>
          <div class="mini"><span>Credit-ready farmers</span><b id="snapCredit"></b></div>
          <div class="mini"><span>Pending visit requests</span><b id="snapVisits"></b></div>
          <div class="rings" id="scoreRing"></div>
        </div>
      </section>

      <section class="grid-2" id="advisoryRow" style="display:none">
        <div class="card">
          <div class="card-head">
            <div>
              <b>AI advisories</b>
              <div class="sub">Latest advisories pushed to farmers</div>
            </div>
          </div>
          <div class="list" id="advisoryList"></div>
        </div>
        <div class="card">
          <div class="card-head">
            <div>
              <b>Season outlook</b>
              <div class="sub">Crops under monitoring by area</div>
            </div>
          </div>
          <div class="area-bars" id="cropBars"></div>
        </div>
      </section>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
<script>
(async function initAdminDashboard() {
  try {
    const { data } = await AG.api("/api/admin/summary");
    const k = data.kpis;
    const hid = (el) => el.style.display = "";

    document.getElementById("loading").style.display = "none";
    hid(document.getElementById("kpis"));
    hid(document.getElementById("chartRow"));
    hid(document.getElementById("networkRow"));
    hid(document.getElementById("advisoryRow"));

    // KPIs
    const kpiDefs = [
      { small: "Farmers onboarded", strong: AG.num(k.farmers), span: `<span>▲ ${AG.num(k.monthFarmers)} this month</span>` },
      { small: "Fields monitored", strong: AG.num(k.fieldsMonitored), span: `<span>${AG.num(k.sensorsOnline)}/${AG.num(k.sensors)} sensors online</span>` },
      { small: "Avg AgriScore", strong: AG.num(k.avgAgriScore), span: `<span>across verified profiles</span>` },
      { small: "Open advisories", strong: String(k.openAdvisories).padStart(2, "0"), span: `<span>${AG.num(k.farmVisitRequests)} visit requests pending</span>` },
      { small: "DCOs active", strong: AG.num(k.dcos), span: `<span>${AG.num(k.orgs)} organizations</span>` },
    ];
    document.getElementById("kpis").innerHTML = kpiDefs.map((d, i) => `
      <div class="kpi-card">
        <small>${d.small}</small>
        <strong>${d.strong}</strong>
        ${d.span}
      </div>`).join("");

    // Weekly signups bar chart
    const days = data.weeklySignups;
    const maxCount = Math.max(1, ...days.map((d) => d.count));
    document.getElementById("signupBars").innerHTML = days.map((d) => {
      const h = Math.max(6, Math.round((d.count / maxCount) * 100));
      const label = new Date(d.day).toLocaleDateString("en", { weekday: "short" });
      return `<div class="bar-col" title="${label}: ${d.count} signups">
        <div class="bar-track"><div class="bar" style="height:${h}%"></div></div>
        <span class="bar-label">${label}</span>
      </div>`;
    }).join("");

    // Health donut
    const hm = data.healthMix;
    document.getElementById("healthDonut").style.setProperty("--a", hm.healthy);
    document.getElementById("healthDonut").style.setProperty("--b", hm.watch);
    document.getElementById("healthDonut").style.setProperty("--c", hm.critical);
    document.getElementById("healthLegend").innerHTML = `
      <span class="legend-item"><i class="dot green"></i>Healthy ${hm.healthy}%</span>
      <span class="legend-item"><i class="dot amber"></i>Watch ${hm.watch}%</span>
      <span class="legend-item"><i class="dot red"></i>Critical ${hm.critical}%</span>`;

    // Network table
    const rows = data.recentFarms;
    document.getElementById("networkRows").innerHTML = rows.length ? rows.map((f) => {
      const stressCls = f.stress === "High" ? "red" : f.stress === "Watch" ? "amber" : "green";
      const statusTag = f.status === "MAPPED" ? `<span class="tag green">Mapped</span>` : `<span class="tag amber">Pending</span>`;
      const score = f.agriScore !== null && f.agriScore !== undefined ? `<span class="tag ${AG.tag(f.agriScore >= 650 ? "HEALTHY" : "WATCHLIST")}">${AG.num(f.agriScore)}</span>` : `<span class="tag gray">—</span>`;
      return `<tr>
        <td><div class="row"><span class="sm">${AG.esc((f.farmer || "F").charAt(0))}</span><span><b>${AG.esc(f.name)}</b><small>${AG.esc(f.state || "—")} · ${AG.num(f.areaHa)} ha</small></span></div></td>
        <td><b>${AG.esc(f.farmer)}</b><small>${AG.esc(f.farmerPhone || "")}</small></td>
        <td>${f.moisture !== null && f.moisture !== undefined ? f.moisture + "%" : "—"}</td>
        <td><span class="tag ${stressCls}">${AG.esc(f.stress || "Low")}</span></td>
        <td>${score}</td>
        <td>${statusTag}</td>
      </tr>`;
    }).join("") : `<tr><td colspan="6" style="color:#88918;padding:24px;text-align:center">No farms registered yet</td></tr>`;

    // Snapshot
    document.getElementById("snapSensors").textContent = `${k.sensorsOnline}/${k.sensors}`;
    document.getElementById("snapMapped").textContent = AG.num(data.gpsPlotCount);
    document.getElementById("snapCredit").textContent = AG.num(data.creditCount);
    document.getElementById("snapVisits").textContent = AG.num(k.farmVisitRequests);
    document.getElementById("scoreRing").innerHTML = `<div class="rings-label"><strong>${AG.num(k.avgAgriScore)}</strong>AgriScore</div>`;

    // Advisor list
    const adv = data.recentAdvisories;
    document.getElementById("advisoryList").innerHTML = adv.length ? adv.map((a) => `
      <div class="i"><span>
        <b>${AG.esc(a.title)}</b>
        <small>${AG.esc(a.type)}${a.farmer ? " · " + AG.esc(a.farmer) : ""} · ${new Date(a.createdAt).toLocaleDateString("en-GB")}</small>
      </span><span class="tag ${AG.tag(a.priority)}">${AG.esc(a.priority)}</span></div>
    `).join("") : `<div class="i"><span>No advisories yet</span></div>`;

    // Crop bars
    const crops = data.crops;
    const maxArea = Math.max(0.1, ...crops.map((c) => c.areaHa));
    document.getElementById("cropBars").innerHTML = crops.map((c) => `
      <div class="ab"><b>${AG.esc(c.crop)}</b><div class="track"><div class="fill" style="width:${Math.max(4, Math.round((c.areaHa / maxArea) * 100))}%"></div></div><span>${AG.num(c.areaHa)} ha</span></div>
    `).join("");

    // advisory badge
    const badge = document.getElementById("advisoryBadge");
    if (badge) badge.textContent = adv.length;
  } catch (err) {
    document.getElementById("loading").textContent = "Failed to load dashboard: " + err.message;
    document.getElementById("loading").style.color = "#c44747";
  }
})();
</script>
</body>
</html>