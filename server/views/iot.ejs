<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'IoT Sensors' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'iot' }) %>
  <div class="main">
    <%- include('partials/topbar', { title: 'IoT Sensors' }) %>
    <div class="content">
      <section class="kpis">
        <div class="kpi-card"><small>Sensors online</small><strong>178/186</strong><span>96% fleet health</span></div>
        <div class="kpi-card"><small>Avg soil moisture</small><strong>62%</strong><span class="amber">4 fields below 50%</span></div>
        <div class="kpi-card"><small>Active alerts</small><strong>05</strong><span>3 high priority</span></div>
        <div class="kpi-card"><small>Avg battery</small><strong>78%</strong><span>8 below 40%</span></div>
      </section>

      <section class="grid-2">
        <div class="card">
          <div class="card-head">
            <div>
              <b>Soil moisture by field</b>
              <div class="sub">Live readings from ground sensors this week</div>
            </div>
            <div class="select">Live ▾</div>
          </div>
          <div class="bar-chart">
            <div class="bar-col">
              <div class="bar-track"><div class="bar active" style="height:74%"></div></div>
              <span class="bar-label">Block A</span>
            </div>
            <div class="bar-col">
              <div class="bar-track"><div class="bar active" style="height:68%"></div></div>
              <span class="bar-label">Block B</span>
            </div>
            <div class="bar-col">
              <div class="bar-track"><div class="bar" style="height:51%"></div></div>
              <span class="bar-label">Block C</span>
            </div>
            <div class="bar-col">
              <div class="bar-track">
                <div class="tooltip">
                  <div>Block D · Stress</div>
                  <b>Moisture 44%</b>
                  Irrigation gap<br>
                  Recommend drill
                </div>
                <div class="bar amber" style="height:44%"></div>
              </div>
              <span class="bar-label">Block D</span>
            </div>
            <div class="bar-col">
              <div class="bar-track"><div class="bar active" style="height:70%"></div></div>
              <span class="bar-label">Block E</span>
            </div>
            <div class="bar-col">
              <div class="bar-track"><div class="bar" style="height:60%"></div></div>
              <span class="bar-label">Block F</span>
            </div>
            <div class="bar-col">
              <div class="bar-track"><div class="bar" style="height:64%"></div></div>
              <span class="bar-label">Block G</span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <b>Live alerts</b>
              <div class="sub">Threshold breaches from sensor fleet</div>
            </div>
            <div class="select">Today ▾</div>
          </div>
          <div class="alerts">
            <div><span class="al-dot"></span><div><b>Moisture below threshold</b><small>Block D · Soil C-142 · 2h ago</small></div></div>
            <div><span class="al-dot"></span><div><b>Battery low</b><small>Block C · Weather W-07 · 5h ago</small></div></div>
            <div><span class="al-dot amber"></span><div><b>Sensor offline</b><small>Block G · Nut N-03 · Yesterday</small></div></div>
          </div>
        </div>
      </section>

      <section class="grid-3">
        <div class="card span-2">
          <div class="card-head">
            <div>
              <b>Sensor fleet status</b>
              <div class="sub">Fleet health, battery and last transmission</div>
            </div>
            <div class="select">All clusters ▾</div>
          </div>
          <table class="table">
            <thead>
              <tr>
                <th>Sensor</th>
                <th>Field</th>
                <th>Type</th>
                <th>Battery</th>
                <th>Last reading</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>S-141</b></td>
                <td>Block A</td>
                <td>Soil moisture</td>
                <td>82%</td>
                <td>2 min ago</td>
                <td><span class="tag green">Online</span></td>
              </tr>
              <tr>
                <td><b>S-142</b></td>
                <td>Block D</td>
                <td>Soil moisture</td>
                <td>71%</td>
                <td>2 min ago</td>
                <td><span class="tag green">Online</span></td>
              </tr>
              <tr>
                <td><b>W-07</b></td>
                <td>Block C</td>
                <td>Weather station</td>
                <td>34%</td>
                <td>5 h ago</td>
                <td><span class="tag amber">Low battery</span></td>
              </tr>
              <tr>
                <td><b>N-03</b></td>
                <td>Block G</td>
                <td>Nutrient</td>
                <td>58%</td>
                <td>Yesterday</td>
                <td><span class="tag red">Offline</span></td>
              </tr>
              <tr>
                <td><b>S-150</b></td>
                <td>Block E</td>
                <td>Soil moisture</td>
                <td>90%</td>
                <td>1 min ago</td>
                <td><span class="tag green">Online</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <b>Weather signal</b>
              <div class="sub">From local weather stations</div>
            </div>
          </div>
          <div class="dev-kpis">
            <div><strong>31°C</strong><small>Temp</small></div>
            <div><strong>62%</strong><small>Humidity</small></div>
            <div><strong>12 mm</strong><small>Rain wk</small></div>
          </div>
          <div class="mini"><span>Wind speed</span><b>9 km/h</b></div>
          <div class="mini"><span>Sunshine</span><b>8.1 h</b></div>
          <div class="mini"><span>Rain forecast</span><b class="amber">Fri</b></div>
        </div>
      </section>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
</body>
</html>