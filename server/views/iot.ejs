<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'IoT Sensors' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'iot' }) %>
  <div class="main">
    <%- include('partials/topbar', { title: 'IoT Sensors' }) %>
    <div class="content">
      <section class="kpis">
        <div class="kpi-card">
          <small>Active sensors</small>
          <strong>58</strong>
          <span>of 62 deployed</span>
        </div>
        <div class="kpi-card">
          <small>Soil moisture</small>
          <strong>34%</strong>
          <span class="amber">below target</span>
        </div>
        <div class="kpi-card">
          <small>Battery health</small>
          <strong>82%</strong>
          <span>fleet average</span>
        </div>
        <div class="kpi-card">
          <small>Alerts today</small>
          <strong>7</strong>
          <span>2 need action</span>
        </div>
      </section>

      <section class="grid-2">
        <div class="card">
          <div class="card-head">
            <div>
              <b>Soil moisture by cluster</b>
              <div class="sub">Average volumetric moisture at 30 cm depth</div>
            </div>
          </div>
          <div class="bar-chart">
            <div class="bar-col">
              <div class="tooltip">52%</div>
              <div class="bar-track"><span style="height:52%"></span></div>
              <div class="bar-label">Rice</div>
            </div>
            <div class="bar-col">
              <div class="tooltip">38%</div>
              <div class="bar-track"><span style="height:38%"></span></div>
              <div class="bar-label">Maize</div>
            </div>
            <div class="bar-col">
              <div class="tooltip">31%</div>
              <div class="bar-track"><span style="height:31%"></span></div>
              <div class="bar-label">Beans</div>
            </div>
            <div class="bar-col">
              <div class="tooltip">24%</div>
              <div class="bar-track"><span style="height:24%"></span></div>
              <div class="bar-label">Tomato</div>
            </div>
          </div>
          <div class="legend">
            <span class="legend-item"><i class="dot green"></i>Healthy</span>
            <span class="legend-item"><i class="dot amber"></i>Watch</span>
            <span class="legend-item"><i class="dot red"></i>Critical</span>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <b>Live alerts</b>
              <div class="sub">Events from soil, weather and battery sensors</div>
            </div>
          </div>
          <div class="alerts">
            <div class="al-item">
              <i class="al-dot red"></i>
              <div><b>Moisture critically low</b><small>Tomato cluster · 10 min ago</small></div>
            </div>
            <div class="al-item">
              <i class="al-dot amber"></i>
              <div><b>Battery below 20%</b><small>STM-014 · 2 h ago</small></div>
            </div>
            <div class="al-item">
              <i class="al-dot amber"></i>
              <div><b>Rain expected Thu</b><small>Kano forecast · 6 h ago</small></div>
            </div>
            <div class="al-item">
              <i class="al-dot green"></i>
              <div><b>Irrigation complete</b><small>Rice cluster · 7 h ago</small></div>
            </div>
          </div>
        </div>
      </section>

      <div class="toolbar">
        <div class="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.2-3.2"/></svg>
          <input type="text" placeholder="Search sensors by ID or cluster">
        </div>
        <button class="btn btn-ghost">All clusters ▾</button>
        <button class="btn btn-primary">+ Deploy sensor</button>
      </div>

      <section class="grid-3">
        <div class="card span-2">
          <div class="card-head">
            <div>
              <b>Sensor fleet</b>
              <div class="sub">Deployed soil, weather and water sensors</div>
            </div>
          </div>
          <div class="table-wrap"><table class="table">
            <thead>
              <tr>
                <th>Sensor</th>
                <th>Type</th>
                <th>Cluster</th>
                <th>Battery</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><div class="row"><span class="sm">01</span><span><b>STM-011</b><small>Deployed Mar 2025</small></span></div></td>
                <td>Soil</td>
                <td>Rice cluster</td>
                <td>86%</td>
                <td><span class="tag green">Online</span></td>
              </tr>
              <tr>
                <td><div class="row"><span class="sm co">02</span><span><b>STM-014</b><small>Deployed Mar 2025</small></span></div></td>
                <td>Soil</td>
                <td>Tomato farms</td>
                <td>17%</td>
                <td><span class="tag amber">Low battery</span></td>
              </tr>
              <tr>
                <td><div class="row"><span class="sm fb">03</span><span><b>WTB-003</b><small>Deployed Jan 2025</small></span></div></td>
                <td>Weather</td>
                <td>Maize belt</td>
                <td>91%</td>
                <td><span class="tag green">Online</span></td>
              </tr>
              <tr>
                <td><div class="row"><span class="sm im">04</span><span><b>WTR-007</b><small>Deployed Feb 2025</small></span></div></td>
                <td>Water</td>
                <td>Rice cluster</td>
                <td>74%</td>
                <td><span class="tag green">Online</span></td>
              </tr>
              <tr>
                <td><div class="row"><span class="sm ne">05</span><span><b>STM-019</b><small>Deployed Apr 2025</small></span></div></td>
                <td>Soil</td>
                <td>Beans block</td>
                <td>63%</td>
                <td><span class="tag maroon">Offline</span></td>
              </tr>
              <tr>
                <td><div class="row"><span class="sm sa">06</span><span><b>WTB-005</b><small>Deployed Jan 2025</small></span></div></td>
                <td>Weather</td>
                <td>Rice cluster</td>
                <td>88%</td>
                <td><span class="tag green">Online</span></td>
              </tr>
            </tbody>
          </table></div>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <b>Weather signal</b>
              <div class="sub">Next 5-day outlook for monitored clusters</div>
            </div>
          </div>
          <div class="minis">
            <div class="mini"><span>High</span><b>28°C</b></div>
            <div class="mini"><span>Low</span><b>21°C</b></div>
            <div class="mini"><span>Rain</span><b>Thu 40%</b></div>
            <div class="mini"><span>Humidity</span><b>68%</b></div>
          </div>
          <div class="seg"><i class="a"></i><i class="b"></i><i class="c"></i></div>
          <div class="legend">
            <span class="legend-item"><i class="dot green"></i>Rain today</span>
            <span class="legend-item"><i class="dot amber"></i>Rain Thu</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
</body>
</html>