<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Analytics' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'analytics' }) %>
  <div class="main">
    <%- include('partials/topbar', { title: 'Analytics' }) %>
    <div class="content">
      <section class="kpis">
        <div class="kpi-card">
          <small>Yield confidence</small>
          <strong>82%</strong>
          <span>▲ 4% vs last season</span>
        </div>
        <div class="kpi-card">
          <small>Field health</small>
          <strong>Good</strong>
          <span>across 142 farms</span>
        </div>
        <div class="kpi-card">
          <small>Total hectarage</small>
          <strong>386</strong>
          <span>under monitoring</span>
        </div>
        <div class="kpi-card">
          <small>Season output</small>
          <strong>₦142M</strong>
          <span>projected value</span>
        </div>
      </section>

      <section class="grid-2">
        <div class="card">
          <div class="card-head">
            <div>
              <b>Yield confidence trend</b>
              <div class="sub">Model confidence by crop across the season</div>
            </div>
          </div>
          <div class="area" style="--v1:20%;--v2:38%;--v3:50%;--v4:62%;--v5:74%;--v6:82%"></div>
          <div class="legend">
            <span class="legend-item"><i class="dot green"></i>Maize</span>
            <span class="legend-item"><i class="dot blue"></i>Rice</span>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <b>Field health mix</b>
              <div class="sub">Health classification across monitored farms</div>
            </div>
          </div>
          <div class="donut" style="--a:58%;--b:29%;--c:13%"></div>
          <div class="legend">
            <span class="legend-item"><i class="dot green"></i>Healthy 58%</span>
            <span class="legend-item"><i class="dot amber"></i>Watch 29%</span>
            <span class="legend-item"><i class="dot red"></i>Critical 13%</span>
          </div>
        </div>
      </section>

      <section class="grid-2">
        <div class="card">
          <div class="card-head">
            <div>
              <b>Top yielding fields</b>
              <div class="sub">Highest projected output this season</div>
            </div>
          </div>
          <div class="table-wrap"><table class="table">
            <thead>
              <tr>
                <th>Plot</th>
                <th>Crop</th>
                <th>Projected</th>
                <th>Confidence</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>CO - Riverside</b><small>Chidi Okeke</small></td>
                <td>Rice</td>
                <td>3.9 t/ha</td>
                <td><span class="tag green">High</span></td>
              </tr>
              <tr>
                <td><b>AY - North field</b><small>Amina Yusuf</small></td>
                <td>Maize</td>
                <td>3.4 t/ha</td>
                <td><span class="tag green">High</span></td>
              </tr>
              <tr>
                <td><b>NE - Hill plot</b><small>Ngozi Eze</small></td>
                <td>Beans</td>
                <td>2.8 t/ha</td>
                <td><span class="tag blue">Med</span></td>
              </tr>
            </tbody>
          </table></div>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <b>Operational summary</b>
              <div class="sub">Season-to-date field operations rollup</div>
            </div>
          </div>
          <div class="grid-2">
            <div class="mini"><span>NDVI scans</span><b>24</b></div>
            <div class="mini"><span>Irrigations</span><b>18</b></div>
            <div class="mini"><span>Fertilizer rounds</span><b>11</b></div>
            <div class="mini"><span>Pest treatments</span><b>6</b></div>
          </div>
          <div class="list">
            <div class="item"><span><i class="dot green"></i>Farms watered</span><div class="progress"><i style="width:72%"></i></div><b>72%</b></div>
            <div class="item"><span><i class="dot amber"></i>Soil samples</span><div class="progress"><i style="width:48%"></i></div><b>48%</b></div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
</body>
</html>