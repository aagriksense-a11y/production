<script>
  const sidebar = document.getElementById("sidebar");
  const menuBtn = document.getElementById("menuBtn");
  if (menuBtn) {
    menuBtn.addEventListener("click", () => sidebar.classList.toggle("open"));
  }

  try {
    const user = JSON.parse(localStorage.getItem("agriksense_user") || "null");
    if (user) {
      const full = [user.firstName, user.lastName].filter(Boolean).join(" ") || "Operator";
      const org = user.organization || "Agriksense Ops";
      const ws = document.getElementById("workspaceName");
      const label = document.getElementById("userLabel");
      const avatar = document.getElementById("userAvatar");
      if (ws) ws.textContent = org;
      if (label) label.textContent = full;
      if (avatar) avatar.textContent = (user.firstName || "A").charAt(0).toUpperCase();
    }
  } catch (_) {}
</script>