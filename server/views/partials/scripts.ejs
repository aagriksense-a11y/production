<script>
  const hasSession = !!localStorage.getItem("agriksense_token");
  if (!hasSession) {
    window.location.replace("/login");
  }

  const sidebar = document.getElementById("sidebar");
  const menuBtn = document.getElementById("menuBtn");
  if (menuBtn) {
    menuBtn.addEventListener("click", () => sidebar.classList.toggle("open"));
  }
  if (sidebar) {
    document.addEventListener("click", (e) => {
      if (!sidebar.classList.contains("open")) return;
      if (sidebar.contains(e.target)) return;
      if (menuBtn && menuBtn.contains(e.target)) return;
      sidebar.classList.remove("open");
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && sidebar.classList.contains("open")) {
        sidebar.classList.remove("open");
      }
    });
    sidebar.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => sidebar.classList.remove("open"));
    });
  }

  const logoutBtn = document.getElementById("logoutBtn");
  if (logoutBtn) {
    logoutBtn.addEventListener("click", () => {
      localStorage.removeItem("agriksense_token");
      localStorage.removeItem("agriksense_refresh");
      localStorage.removeItem("agriksense_user");
      window.location.href = "/login";
    });
  }

  try {
    const user = JSON.parse(localStorage.getItem("agriksense_user") || "null");
    if (user) {
      const profile = user.profile || {};
      const full = profile.type === "organization"
        ? (profile.orgName || "Operator")
        : ([profile.firstName, profile.lastName].filter(Boolean).join(" ") || "Operator");
      const label = document.getElementById("userLabel");
      const avatar = document.getElementById("userAvatar");
      if (label) label.textContent = full;
      if (avatar) avatar.textContent = (profile.firstName || "O").charAt(0).toUpperCase();
    }
  } catch (_) {}
</script>