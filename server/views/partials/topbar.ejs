<header class="topbar">
  <div class="topbar-left">
    <button class="icon-btn mobile-toggle" id="menuBtn" aria-label="Open menu">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <h1><%= title %></h1>
    <div class="pill"><span class="dot"></span> Field network live</div>
  </div>
  <div class="topbar-right">
    <button class="icon-btn" aria-label="Search">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.2-3.2"/></svg>
    </button>
    <button class="icon-btn" aria-label="Alerts">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10 21a2 2 0 0 0 4 0"/></svg>
    </button>
    <div class="user-chip">
      <span class="avatar" id="userAvatar">A</span>
      <span id="userLabel">Operator</span>
    </div>
  </div>
</header>