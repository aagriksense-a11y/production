<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'AgriScore' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'agriscore' }) %>
  <div class="main">
    <%- include('partials/topbar', { title: 'AgriScore' }) %>
    <div class="content">
      <section class="kpis">
        <div class="kpi-card">
          <small>Farmers scored</small>
          <strong>172</strong>
          <span>of 186 onboarded</span>
        </div>
        <div class="kpi-card">
          <small>Avg AgriScore</small>
          <strong>681</strong>
          <span>▲ 24 this quarter</span>
        </div>
        <div class="kpi-card">
          <small>Credit-ready</small>
          <strong>112</strong>
          <span>score ≥ 600</span>
        </div>
        <div class="kpi-card">
          <small>Loan access</small>
          <strong>₦86M</strong>
          <span class="amber">approved pipeline</span>
        </div>
      </section>

      <section class="grid-2">
        <div class="card">
          <div class="card-head">
            <div>
              <b>Score bands</b>
              <div class="sub">Farmer distribution across AgriScore bands</div>
            </div>
          </div>
          <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Band</th>
                <th>Range</th>
                <th>Farmers</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>Excellent</b></td>
                <td>800 - 900</td>
                <td>24</td>
                <td><span class="tag green">Credit-ready</span></td>
              </tr>
              <tr>
                <td><b>Good</b></td>
                <td>700 - 799</td>
                <td>51</td>
                <td><span class="tag green">Credit-ready</span></td>
              </tr>
              <tr>
                <td><b>Fair</b></td>
                <td>600 - 699</td>
                <td>37</td>
                <td><span class="tag blue">Qualifying</span></td>
              </tr>
              <tr>
                <td><b>Needs data</b></td>
                <td>400 - 599</td>
                <td>44</td>
                <td><span class="tag amber">Docs pending</span></td>
              </tr>
              <tr>
                <td><b>Low trust</b></td>
                <td>0 - 399</td>
                <td>16</td>
                <td><span class="tag red">Review</span></td>
              </tr>
            </tbody>
          </table>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <b>Credit readiness</b>
              <div class="sub">Monthly pipeline toward lending partners</div>
            </div>
          </div>
          <div class="rings">
            <div class="rings-label"><strong>112</strong>farmers</div>
          </div>
          <div class="mini"><span>Score inputs</span><b>Yield + plots + repayment</b></div>
          <div class="mini"><span>Data sources</span><b>NIN, BVN, drone NDVI</b></div>
          <div class="mini"><span>Avg verified score</span><b>712</b></div>
        </div>
      </section>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
</body>
</html>