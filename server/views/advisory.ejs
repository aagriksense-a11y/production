<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'AI Advisory' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'advisory' }) %>
  <div class="main">
    <%- include('partials/topbar', { title: 'AI Advisory' }) %>
    <div class="content">
      <section class="kpis">
        <div class="kpi-card"><small>Advisories today</small><strong>07</strong><span>▲ 2 vs yesterday</span></div>
        <div class="kpi-card"><small>High priority</small><strong>03</strong><span class="amber">Needs action</span></div>
        <div class="kpi-card"><small>Languages</small><strong>04</strong><span>EN, HA, YO, IG</span></div>
        <div class="kpi-card"><small>Delivery rate</small><strong>98%</strong><span>Via SMS / USSD</span></div>
      </section>

      <section class="grid-2">
        <div class="card">
          <div class="card-head">
            <div>
              <b>Advisory queue</b>
              <div class="sub">Automated insights generated per field</div>
            </div>
            <div class="select">Today ▾</div>
          </div>
          <table class="table">
            <thead>
              <tr>
                <th>Field</th>
                <th>Advisory</th>
                <th>Priority</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>Block D</b><br><small>Ibrahim Musa</small></td>
                <td>Irrigation gap detected</td>
                <td><span class="tag red">High</span></td>
                <td><span class="status-live">Sending</span></td>
              </tr>
              <tr>
                <td><b>Block C</b><br><small>Fatima Bello</small></td>
                <td>Fertilise after rainfall</td>
                <td><span class="tag amber">Medium</span></td>
                <td><span class="status-done">Sent</span></td>
              </tr>
              <tr>
                <td><b>Block F</b><br><small>Usman Danladi</small></td>
                <td>Pest scout reminder</td>
                <td><span class="tag amber">Medium</span></td>
                <td><span class="status-done">Sent</span></td>
              </tr>
              <tr>
                <td><b>Block A</b><br><small>Amina Yusuf</small></td>
                <td>Canopy stress scan due</td>
                <td><span class="tag blue">Low</span></td>
                <td><span class="status-wait">Queued</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <b>Delivery channels</b>
              <div class="sub">Local language alerts to farmers</div>
            </div>
          </div>
          <div class="seg seg-lg"><i class="a"></i><i class="b"></i><i class="c"></i></div>
          <div class="legend">
            <span><i style="background:#0b5b3e"></i>SMS 64%</span>
            <span><i style="background:#d5f17f"></i>USSD 21%</span>
            <span><i style="background:#3d6bff"></i>Voice note 15%</span>
          </div>
          <div class="mini"><span>SMS delivered</span><b>142</b></div>
          <div class="mini"><span>USSD sessions</span><b>47</b></div>
          <div class="mini"><span>Voice notes sent</span><b>33</b></div>
          <div class="mini"><span>Confirmation rate</span><b>91%</b></div>
        </div>
      </section>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
</body>
</html>