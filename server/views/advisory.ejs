<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'AI Advisory' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'advisory' }) %>
  <div class="main">
    <%- include('partials/topbar', { title: 'AI Advisory' }) %>
    <div class="content">
      <section class="kpis">
        <div class="kpi-card">
          <small>Advisories sent</small>
          <strong>1,284</strong>
          <span>▲ 212 this week</span>
        </div>
        <div class="kpi-card">
          <small>Read rate</small>
          <strong>76%</strong>
          <span>across SMS + USSD</span>
        </div>
        <div class="kpi-card">
          <small>Acted on</small>
          <strong>41%</strong>
          <span>of read advisories</span>
        </div>
        <div class="kpi-card">
          <small>Languages</small>
          <strong>4</strong>
          <span class="amber">EN, HA, IG, YO</span>
        </div>
      </section>

      <section class="grid-2">
        <div class="card">
          <div class="card-head">
            <div>
              <b>Advisory queue</b>
              <div class="sub">Generated advisories sorted by urgency</div>
            </div>
          </div>
          <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Type</th>
                <th>Topic</th>
                <th>Channel</th>
                <th>Farmers</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>Irrigation</b><small>Weekly</small></td>
                <td>Rice cluster moisture low</td>
                <td>SMS + USSD</td>
                <td>38</td>
                <td><span class="tag green">Sent</span></td>
              </tr>
              <tr>
                <td><b>Fertilizer</b><small>Growth stage</small></td>
                <td>Maize early nitrogen topdress</td>
                <td>SMS</td>
                <td>52</td>
                <td><span class="tag green">Sent</span></td>
              </tr>
              <tr>
                <td><b>Pest alert</b><small>Urgent</small></td>
                <td>Tomato whitefly detected</td>
                <td>SMS + USSD</td>
                <td>7</td>
                <td><span class="tag amber">Queued</span></td>
              </tr>
              <tr>
                <td><b>Market</b><small>Weekly</small></td>
                <td>Maize price spike - sell window</td>
                <td>USSD</td>
                <td>186</td>
                <td><span class="tag amber">Queued</span></td>
              </tr>
            </tbody>
          </table>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <b>Delivery channels</b>
              <div class="sub">Advisory reach by channel</div>
            </div>
          </div>
          <div class="dev-kpis">
            <div class="dev"><b>SMS</b><span>54%</span></div>
            <div class="dev"><b>USSD</b><span>31%</span></div>
            <div class="dev"><b>Voice</b><span>15%</span></div>
          </div>
          <div class="list">
            <div class="item"><span><i class="dot green"></i>Delivered</span><div class="progress"><i style="width:76%"></i></div><b>76%</b></div>
            <div class="item"><span><i class="dot amber"></i>Read</span><div class="progress"><i style="width:61%"></i></div><b>61%</b></div>
            <div class="item"><span><i class="dot amber"></i>Acted</span><div class="progress"><i style="width:41%"></i></div><b>41%</b></div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
</body>
</html>