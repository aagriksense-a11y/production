<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Farms & Plots' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'farms' }) %>
  <div class="main">
    <%- include('partials/topbar', { title: 'Farms & Plots' }) %>
    <div class="content">
      <div id="loading" class="card">Loading farms & plots…</div>

      <section class="kpis" id="kpis" style="display:none"></section>

      <div class="toolbar" id="toolbar" style="display:none">
        <div class="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.2-3.2"/></svg>
          <input type="text" id="searchInput" placeholder="Search farms by name, farmer or location">
        </div>
        <select id="cropFilter" class="select"><option value="">All crops</option></select>
        <select id="stateFilter" class="select"><option value="">All states</option></select>
        <button class="btn btn-ghost" id="assignBtn">Assign to DCO</button>
        <button class="btn btn-primary" id="addPlotBtn">+ Register plot</button>
      </div>

      <section class="grid-3">
        <div class="card span-2">
          <div class="card-head">
            <div>
              <b>Farm & plot network</b>
              <div class="sub" id="resultCount"></div>
            </div>
          </div>
          <div class="table-wrap"><table class="table">
            <thead>
              <tr>
                <th>Field</th>
                <th>Crop</th>
                <th>Area</th>
                <th>Location</th>
                <th>Moisture</th>
                <th>Map</th>
              </tr>
            </thead>
            <tbody id="plotRows"></tbody>
          </table></div>
        </div>

        <div class="card">
          <b>Plot GPS mapping</b>
          <div class="mini"><span>Mapped</span><b id="mapMapped"></b></div>
          <div class="mini"><span>Pending</span><b id="mapPending"></b></div>
          <div class="mini"><span>Area under watch</span><b id="mapArea"></b></div>
          <div class="map" id="plotMap"><span id="mapEmpty" style="color:#667068;font-size:12px;display:grid;place-items:center;height:100%">Map preview</span></div>
          <div class="legend">
            <span class="legend-item"><i class="dot green"></i>Mapped</span>
            <span class="legend-item"><i class="dot amber"></i>Pending</span>
          </div>
        </div>
      </section>

      <section class="grid-2" id="cropRow" style="display:none">
        <div class="card">
          <div class="card-head"><div><b>Area by crop</b><div class="sub">Hectares under monitoring per crop</div></div></div>
          <div class="area-bars" id="cropBars"></div>
        </div>
        <div class="card">
          <div class="card-head"><div><b>Fare rates</b><div class="sub">Transport cost per mile by state (admin)</div></div></div>
          <div class="table-wrap"><table class="table">
            <thead><tr><th>State</th><th>₦ / mile</th></tr></thead>
            <tbody id="fareRows"></tbody>
          </table></div>
        </div>
      </section>
    </div>
  </div>
</div>

<!-- Register plot modal -->
<div class="modal" id="plotModal" style="display:none">
  <div class="modal-card">
    <div class="card-head">
      <div><b>Register plot</b><div class="sub">Add a plot under an existing farm</div></div>
      <button class="icon-btn" id="plotClose">✕</button>
    </div>
    <form id="plotForm" class="form-grid">
      <div class="form-group full"><label>Farm *</label><select name="farmId" id="farmSelect" required></select></div>
      <div class="form-group"><label>Plot name *</label><input name="name" required placeholder="e.g. AY - North field"></div>
      <div class="form-group"><label>Crop *</label><input name="crop" required placeholder="Maize"></div>
      <div class="form-group"><label>Area (ha)</label><input name="areaHa" type="number" step="0.1"></div>
      <div class="form-group"><label>Season</label><input name="season" placeholder="2026 Wet"></div>
      <div class="form-group"><label>Cluster</label><input name="cluster" placeholder="Maize belt"></div>
      <div class="form-group"><label>Soil moisture (%)</label><input name="soilMoisture" type="number" step="1"></div>
      <div class="form-group"><label>Stress level</label><select name="stressLevel"><option value="">—</option><option>Low</option><option>Watch</option><option>High</option></select></div>
      <div class="form-group"><label>Latitude (optional)</label><input name="lat" type="number" step="any"></div>
      <div class="form-group"><label>Longitude (optional)</label><input name="lng" type="number" step="any"></div>
      <div class="form-actions"><button class="btn btn-primary" type="submit">Register plot</button><span class="form-error" id="plotError"></span></div>
    </form>
  </div>
</div>

<!-- Assign to DCO modal -->
<div class="modal" id="assignModal" style="display:none">
  <div class="modal-card">
    <div class="card-head">
      <div><b>Assign farms to DCO</b><div class="sub">Select a DCO and farms for the next field visit</div></div>
      <button class="icon-btn" id="assignClose">✕</button>
    </div>
    <form id="assignForm" class="form-grid">
      <div class="form-group full"><label>Data Collection Officer *</label><select name="dcoUserId" id="dcoSelect" required></select></div>
      <div class="form-group full"><label>Farms *</label><select name="farmIds" id="farmAssignSelect" multiple required style="height:140px"></select>
        <small style="color:#889189">Ctrl / Cmd + click to select multiple</small></div>
      <div class="form-group full"><label>Note (optional)</label><input name="note"></div>
      <div class="form-actions"><button class="btn btn-primary" type="submit">Assign farms</button><span class="form-error" id="assignError"></span></div>
    </form>
  </div>
</div>

<%- include('partials/scripts') %>
<script>
let allPlots = [];

function mode(arr) { return [...arr].filter((v, i, a) => a.indexOf(v) === i); }

async function loadData() {
  const [farmData, plotData, fareData, dcoData] = await Promise.all([
    AG.api("/api/admin/farms?limit=200"),
    AG.api("/api/admin/plots"),
    AG.api("/api/admin/fare-rates"),
    AG.api("/api/admin/dcos"),
  ]);
  allPlots = plotData.data;
  renderPlots();
  renderKpis(farmData.data);
  renderFares(fareData.data);
  populateFarmSelect(farmData.data.rows);
  populateDcoSelect(dcoData.data);
  populateAssignFarms(farmData.data.rows);
  document.getElementById("cropRow").style.display = "grid";

  // populate filters
  const crops = mode(allPlots.map((p) => p.crop).filter(Boolean)).sort();
  const states = mode(allPlots.map((p) => p.state).filter(Boolean)).sort();
  document.getElementById("cropFilter").insertAdjacentHTML("beforeend", crops.map((c) => `<option>${AG.esc(c)}</option>`).join(""));
  document.getElementById("stateFilter").insertAdjacentHTML("beforeend", states.map((s) => `<option>${AG.esc(s)}</option>`).join(""));
}

function renderKpis(farmData) {
  const totalHa = allPlots.reduce((a, p) => a + (p.areaHa || 0), 0);
  const mapped = allPlots.filter((p) => p.mapStatus === "MAPPED").length;
  const topCrops = mode(allPlots.map((p) => p.crop).filter(Boolean)).slice(0, 3).join(", ");
  document.getElementById("kpis").innerHTML = `
    <div class="kpi-card"><small>Active farms</small><strong>${AG.num(farmData.total)}</strong><span>registered farms</span></div>
    <div class="kpi-card"><small>Total hectares</small><strong>${AG.num(Math.round(totalHa * 10) / 10)}</strong><span>${AG.num(allPlots.length)} plots</span></div>
    <div class="kpi-card"><small>Crops monitored</small><strong>${AG.num(mode(allPlots.map((p) => p.crop).filter(Boolean)).length)}</strong><span>${AG.esc(topCrops || "—")}</span></div>
    <div class="kpi-card"><small>Plots mapped</small><strong>${AG.num(mapped)}</strong><span class="amber">${AG.num(allPlots.length - mapped)} pending GPS</span></div>`;
  document.getElementById("kpis").style.display = "grid";
  document.getElementById("toolbar").style.display = "flex";
  document.getElementById("loading").style.display = "none";

  document.getElementById("mapMapped").textContent = AG.num(mapped);
  document.getElementById("mapPending").textContent = AG.num(allPlots.length - mapped);
  document.getElementById("mapArea").textContent = AG.num(Math.round(totalHa * 10) / 10) + " ha";

  const pins = allPlots.filter((p) => p.lat != null && p.lng != null).slice(0, 8);
  const mapEl = document.getElementById("plotMap");
  if (pins.length) {
    const minLat = Math.min(...pins.map((p) => p.lat)), maxLat = Math.max(...pins.map((p) => p.lat));
    const minLng = Math.min(...pins.map((p) => p.lng)), maxLng = Math.max(...pins.map((p) => p.lng));
    const spanLat = Math.max(0.01, maxLat - minLat), spanLng = Math.max(0.01, maxLng - minLng);
    mapEl.innerHTML = pins.map((p) => {
      const x = Math.round(((p.lng - minLng) / spanLng) * 88 + 6);
      const y = Math.round(((maxLat - p.lat) / spanLat) * 78 + 8);
      return `<span class="pin" style="left:${x}%;top:${y}%" title="${AG.esc(p.name)}»"></span>`;
    }).join("");
  } else {
    mapEl.innerHTML = `<span style="grid-area:1/1;color:#667068;font-size:12px;display:grid;place-items:center;height:100%">${AG.esc("No GPS coordinates yet")}</span>`;
  }
}

function renderPlots() {
  const q = (document.getElementById("searchInput").value || "").toLowerCase();
  const crop = document.getElementById("cropFilter").value;
  const state = document.getElementById("stateFilter").value;
  let plots = allPlots;
  if (q) plots = plots.filter((p) => (p.name + " " + p.farmName + " " + (p.farmer || "")).toLowerCase().includes(q));
  if (crop) plots = plots.filter((p) => p.crop === crop);
  if (state) plots = plots.filter((p) => p.state === state);

  document.getElementById("resultCount").textContent = `${AG.num(plots.length)} plots`;
  document.getElementById("plotRows").innerHTML = plots.length ? plots.map((p) => {
    const moisture = p.soilMoisture != null ? (p.soilMoisture + "%") : "—";
    const stressCls = p.stressLevel === "High" ? "red" : p.stressLevel === "Watch" ? "amber" : "green";
    const mapTag = p.mapStatus === "MAPPED" ? `<span class="tag green">Mapped</span>` : `<span class="tag amber">Pending</span>`;
    return `<tr>
      <td><div class="row"><span class="sm">${AG.esc((p.farmer || "F").charAt(0))}</span><span><b>${AG.esc(p.name)}</b><small>${AG.esc(p.farmName)} · ${AG.esc(p.farmer || "")}</small></span></div></td>
      <td>${AG.esc(p.crop || "—")}</td>
      <td>${p.areaHa ? p.areaHa + " ha" : "—"}</td>
      <td>${p.state ? AG.esc(p.state) : "—"}</td>
      <td><span class="tag ${stressCls}">${moisture}</span></td>
      <td>${mapTag}</td>
    </tr>`;
  }).join("") : `<tr><td colspan="6" style="padding:30px;text-align:center;color:#889189">No plots match your filters</td></tr>`;

  const crops = mode(plots.map((p) => p.crop).filter(Boolean));
  const maxArea = Math.max(0.1, ...crops.map((c) => plots.filter((p) => p.crop === c).reduce((a, p) => a + (p.areaHa || 0), 0)));
  document.getElementById("cropBars").innerHTML = crops.map((c) => {
    const area = plots.filter((p) => p.crop === c).reduce((a, p) => a + (p.areaHa || 0), 0);
    return `<div class="ab"><b>${AG.esc(c)}</b><div class="track"><div class="fill" style="width:${Math.max(4, Math.round((area / maxArea) * 100))}%"></div></div><span>${AG.num(Math.round(area * 10) / 10)} ha</span></div>`;
  }).join("");
}

function renderFares(fares) {
  document.getElementById("fareRows").innerHTML = fares.length ? fares.map((f) => `
    <tr><td><b>${AG.esc(f.state)}</b></td><td>${AG.money(f.costPerMile)}</td></tr>
  `).join("") : `<tr><td colspan="2" style="padding:20px;text-align:center;color:#889189">No fare rates set</td></tr>`;
}

function populateFarmSelect(farms) {
  document.getElementById("farmSelect").innerHTML = farms.map((f) => `<option value="${f.id}">${AG.esc(f.name)} — ${AG.esc(f.farmer)}</option>`).join("");
}
function populateAssignFarms(farms) {
  document.getElementById("farmAssignSelect").innerHTML = farms.map((f) => `<option value="${f.id}">${AG.esc(f.name)} — ${AG.esc(f.state)}</option>`).join("");
}
function populateDcoSelect(dcos) {
  document.getElementById("dcoSelect").innerHTML = dcos.map((d) => `<option value="${d.id}">${AG.esc(d.fullName)} — ${AG.esc(d.state || "")}</option>`).join("");
}

(function initFarms() {
  loadData().catch((err) => {
    document.getElementById("loading").textContent = "Failed to load farms: " + err.message;
    document.getElementById("loading").style.color = "#c44747";
  });
})();

document.getElementById("searchInput").addEventListener("input", debounce(renderPlots, 250));
document.getElementById("cropFilter").addEventListener("change", renderPlots);
document.getElementById("stateFilter").addEventListener("change", renderPlots);

document.getElementById("addPlotBtn").addEventListener("click", () => document.getElementById("plotModal").style.display = "flex");
document.getElementById("plotClose").addEventListener("click", () => document.getElementById("plotModal").style.display = "none");
document.getElementById("assignBtn").addEventListener("click", () => document.getElementById("assignModal").style.display = "flex");
document.getElementById("assignClose").addEventListener("click", () => document.getElementById("assignModal").style.display = "none");

document.getElementById("plotForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const form = e.target;
  const payload = Object.fromEntries(new FormData(form).entries());
  document.getElementById("plotError").textContent = "";
  try {
    await AG.api("/api/admin/plots", { method: "POST", body: JSON.stringify(payload) });
    document.getElementById("plotModal").style.display = "none";
    form.reset();
    loadData();
  } catch (err) { document.getElementById("plotError").textContent = err.message; }
});

document.getElementById("assignForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const form = e.target;
  const fd = new FormData(form);
  const payload = {
    dcoUserId: fd.get("dcoUserId"),
    note: fd.get("note"),
    farmIds: fd.getAll("farmIds"),
  };
  document.getElementById("assignError").textContent = "";
  try {
    await AG.api("/api/admin/assignments", { method: "POST", body: JSON.stringify(payload) });
    document.getElementById("assignModal").style.display = "none";
    form.reset();
  } catch (err) { document.getElementById("assignError").textContent = err.message; }
});

function debounce(fn, ms) { let t; return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); }; }
</script>
</body>
</html>