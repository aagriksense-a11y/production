<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Farms & Plots' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'farms' }) %>
  <div class="main">
    <%- include('partials/topbar', { title: 'Farms & Plots' }) %>
    <div class="content">
      <section class="kpis">
        <div class="kpi-card"><small>Total fields</small><strong>42</strong><span>▲ 3 this month</span></div>
        <div class="kpi-card"><small>Total area</small><strong>92.6 ha</strong><span>Across 9 LGA</span></div>
        <div class="kpi-card"><small>GPS coverage</small><strong>95.2%</strong><span>40 of 42 plotted</span></div>
        <div class="kpi-card"><small>Avg soil moisture</small><strong>62%</strong><span class="amber">4 fields below 50%</span></div>
      </section>

      <section class="grid-3">
        <div class="card">
          <b>North cluster</b>
          <div class="mini"><span>Fields</span><b>14</b></div>
          <div class="mini"><span>Mapped area</span><b>31.2 ha</b></div>
          <div class="mini"><span>Avg moisture</span><b>61%</b></div>
          <div class="mini"><span>Active alerts</span><b class="red">02</b></div>
        </div>
        <div class="card">
          <b>Central cluster</b>
          <div class="mini"><span>Fields</span><b>12</b></div>
          <div class="mini"><span>Mapped area</span><b>27.4 ha</b></div>
          <div class="mini"><span>Avg moisture</span><b>66%</b></div>
          <div class="mini"><span>Active alerts</span><b>00</b></div>
        </div>
        <div class="card">
          <b>South cluster</b>
          <div class="mini"><span>Fields</span><b>16</b></div>
          <div class="mini"><span>Mapped area</span><b>34.0 ha</b></div>
          <div class="mini"><span>Avg moisture</span><b>58%</b></div>
          <div class="mini"><span>Active alerts</span><b class="red">03</b></div>
        </div>
      </section>

      <section class="grid-3">
        <div class="card span-2">
          <div class="card-head">
            <div>
              <b>Farm & plot network</b>
              <div class="sub">GPS-mapped plots with live telemetry and crop stage</div>
            </div>
            <div class="select">All clusters ▾</div>
          </div>
          <table class="table">
            <thead>
              <tr>
                <th>Field / Plot</th>
                <th>Farmer</th>
                <th>Crop</th>
                <th>Area</th>
                <th>Moisture</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>Block A</b><br><small>Plot A1 · GPS locked</small></td>
                <td>Amina Yusuf</td>
                <td>Maize</td>
                <td>2.4 ha</td>
                <td>74%</td>
                <td><span class="tag green">Healthy</span></td>
              </tr>
              <tr>
                <td><b>Block B</b><br><small>Plot B1 · GPS locked</small></td>
                <td>Chidi Okeke</td>
                <td>Maize</td>
                <td>1.8 ha</td>
                <td>68%</td>
                <td><span class="tag green">Healthy</span></td>
              </tr>
              <tr>
                <td><b>Block C</b><br><small>Plot C1-C3 · GPS locked</small></td>
                <td>Fatima Bello</td>
                <td>Sorghum</td>
                <td>3.1 ha</td>
                <td>51%</td>
                <td><span class="tag amber">Watchlist</span></td>
              </tr>
              <tr>
                <td><b>Block D</b><br><small>Plot D1-D2 · GPS locked</small></td>
                <td>Ibrahim Musa</td>
                <td>Millet</td>
                <td>2.0 ha</td>
                <td>44%</td>
                <td><span class="tag blue">Advisory</span></td>
              </tr>
              <tr>
                <td><b>Block E</b><br><small>Plot E1 · GPS pending</small></td>
                <td>Ngozi Eze</td>
                <td>Rice</td>
                <td>2.6 ha</td>
                <td>70%</td>
                <td><span class="tag gray">Mapping due</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <b>Plot GPS mapping</b>
              <div class="sub">Digital farm profiles for credit scoring</div>
            </div>
          </div>
          <div class="progress">
            <span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span>
          </div>
          <div class="mini"><span>Plot polygons mapped</span><b>40/42</b></div>
          <div class="mini"><span>Verified boundaries</span><b>36</b></div>
          <div class="mini"><span>Need revisits</span><b>02</b></div>
          <div class="mini"><span>Awaiting farmer pickup</span><b>04</b></div>
        </div>
      </section>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
</body>
</html>