{
  "name": "agriksense-server",
  "version": "1.0.0",
  "description": "Agriksense API - Fastify + Prisma + MySQL",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "predev": "node scripts/kill-port.js",
    "dev": "node --watch src/index.js",
    "prestart": "node scripts/kill-port.js",
    "start": "node src/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "ejs": "^6.0.1",
    "fastify": "^5.3.3",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "prisma": "^6.9.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
