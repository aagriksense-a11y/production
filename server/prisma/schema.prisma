generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FARMER
  DATA_COLLECTION_OFFICER
  ORGANIZATION
  ADMIN
}

enum OnboardingStatus {
  PHASE_1_BASIC
  PHASE_2_COMPLETED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum PlotStatus {
  ACTIVE
  DORMANT
  HARVESTED
}

enum MapStatus {
  MAPPED
  PENDING
}

enum SensorType {
  SOIL_MOISTURE
  SOIL_NUTRIENT
  WEATHER
  TEMPERATURE
}

enum SensorStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum AdvisoryType {
  IRRIGATION
  PEST_DISEASE
  INPUT_TIMING
  SOIL_HEALTH
  HARVEST
  AI_ADVICE
}

enum AdvisoryPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AdvisoryChannel {
  WHATSAPP
  SMS
  USSD
  EMAIL
}

enum VisitStatus {
  REQUESTED
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  VISITED
  COMPLETED
}

model User {
  id             String           @id @default(cuid())
  platformId     String           @unique @default("")
  role           UserRole
  email          String?          @unique
  phoneNumber    String?          @unique
  passwordHash   String?
  authProvider   AuthProvider     @default(LOCAL)
  onboardingStep OnboardingStatus @default(PHASE_1_BASIC)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  farmerProfile FarmerProfile?
  dcoProfile    DcoProfile?
  orgProfile    OrgProfile?
  refreshTokens RefreshToken[]
  bankAccounts  BankAccount[]
  farms         Farm[]
  advisories    Advisory[]
  visitRequests FarmVisitRequest[] @relation("VisitRequestDco")
  visitDecided  FarmVisitRequest[] @relation("VisitDecider")
  assignments   FarmAssignment[] @relation("DcoAssignments")

  @@index([platformId])
  @@index([role])
  @@map("users")
}

model FarmerProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  firstName         String
  lastName          String
  otherName         String?
  consentAccepted   Boolean            @default(false)
  consentAcceptedAt DateTime?
  altPhoneNumber    String?
  nin               String?
  ninDocUrl         String?
  ninStatus         VerificationStatus @default(PENDING)
  address           String?
  cityTown          String?
  lga               String?
  state             String?
  avatarUrl         String?
  managerName       String?
  managerPhone      String?
  managerEmail      String?
  agriScore         Int?
  creditReady       Boolean          @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user                    User                     @relation(fields: [userId], references: [id])
  organizationMemberships OrganizationMembership[]

  @@index([userId])
}

model DcoProfile {
  id             String             @id @default(cuid())
  userId         String             @unique
  firstName      String
  lastName       String
  otherName      String?
  altPhoneNumber String?
  nin            String?
  ninDocUrl      String?
  ninStatus      VerificationStatus @default(PENDING)
  address        String?
  cityTown       String?
  lga            String?
  state          String?
  avatarUrl      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OrgProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  orgName             String
  headquartersAddress String?
  cityTown            String?
  lga                 String?
  state               String?
  isRegistered        Boolean            @default(false)
  cacNumber           String?
  cacStatus           VerificationStatus @default(PENDING)
  cacCertUrl          String?
  cacForm2Url         String?
  cacForm7Url         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user        User                     @relation(fields: [userId], references: [id])
  directors   Director[]
  memberships OrganizationMembership[]

  @@index([userId])
}

model Director {
  id             String   @id @default(cuid())
  orgProfileId   String
  fullName       String
  phoneNumber    String
  email          String?
  nin            String
  ninDocUrl      String?
  address        String?
  utilityBillUrl String?
  createdAt      DateTime @default(now())

  orgProfile OrgProfile @relation(fields: [orgProfileId], references: [id])

  @@index([orgProfileId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  accountName   String
  accountNumber String
  bankName      String
  bankCode      String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OrganizationMembership {
  id           String    @id @default(cuid())
  farmerId     String
  orgId        String
  membershipId String
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  farmer          FarmerProfile @relation(fields: [farmerProfileId], references: [id])
  organization    OrgProfile    @relation(fields: [orgProfileId], references: [id])
  farmerProfileId String
  orgProfileId    String

  @@unique([farmerId, orgId])
  @@index([orgId])
}

model Farm {
  id          String   @id @default(cuid())
  name        String
  description String?
  state       String?
  lga         String?
  cityTown    String?
  village     String?
  landmark    String?
  address     String?
  lat         Float?
  lng         Float?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User              @relation(fields: [ownerId], references: [id])
  plots       Plot[]
  assignments FarmAssignment[]
  visitFarms  FarmVisitFarm[]

  @@index([ownerId])
  @@index([state])
}

model Plot {
  id            String    @id @default(cuid())
  name          String
  crop          String?
  areaHa        Float?
  soilHealth    String?
  soilMoisture  Float?
  stressLevel   String?
  cluster       String?
  season        String?
  plantedAt     DateTime?
  status        PlotStatus @default(ACTIVE)
  mapStatus     MapStatus  @default(PENDING)
  lat           Float?
  lng           Float?
  farmId        String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  farm      Farm            @relation(fields: [farmId], references: [id])
  sensors   Sensor[]
  advisories Advisory[]

  @@index([farmId])
  @@index([crop])
}

model Sensor {
  id         String       @id @default(cuid())
  name       String
  sensorType SensorType   @default(SOIL_MOISTURE)
  status     SensorStatus @default(ONLINE)
  battery    Int?
  plotId     String
  createdAt  DateTime     @default(now())

  plot     Plot            @relation(fields: [plotId], references: [id])
  readings SensorReading[]

  @@index([plotId])
}

model SensorReading {
  id         String   @id @default(cuid())
  sensorId   String
  value      Float
  unit       String
  recordedAt DateTime @default(now())

  sensor Sensor @relation(fields: [sensorId], references: [id])

  @@index([sensorId])
}

model Advisory {
  id          String           @id @default(cuid())
  title       String
  body        String
  type        AdvisoryType     @default(AI_ADVICE)
  priority    AdvisoryPriority @default(MEDIUM)
  channel     AdvisoryChannel  @default(WHATSAPP)
  language    String           @default("en")
  sent        Boolean          @default(false)
  sentAt      DateTime?
  plotId      String?
  farmerId    String?
  createdAt   DateTime         @default(now())

  plot   Plot? @relation(fields: [plotId], references: [id])
  farmer User? @relation(fields: [farmerId], references: [id])

  @@index([plotId])
  @@index([farmerId])
}

model FareRate {
  id          String   @id @default(cuid())
  state       String   @unique
  costPerMile Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FarmVisitRequest {
  id               String      @id @default(cuid())
  dcoUserId        String
  status           VisitStatus @default(REQUESTED)
  farmCount        Int         @default(0)
  estimatedCost    Float?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  decidedByUserId  String?

  dco      User              @relation("VisitRequestDco", fields: [dcoUserId], references: [id])
  decidedBy User?            @relation("VisitDecider", fields: [decidedByUserId], references: [id])
  farms    FarmVisitFarm[]

  @@index([dcoUserId])
}

model FarmVisitFarm {
  id            String   @id @default(cuid())
  requestId     String
  farmId        String?
  farmName      String?
  address       String?
  state         String?
  transportCost Float?
  distanceKm    Float?

  request FarmVisitRequest @relation(fields: [requestId], references: [id])
  farm    Farm?            @relation(fields: [farmId], references: [id])

  @@index([requestId])
}

model FarmAssignment {
  id          String           @id @default(cuid())
  farmId      String
  dcoUserId   String
  status      AssignmentStatus @default(ASSIGNED)
  notes       String?
  assignedAt  DateTime         @default(now())
  visitedAt   DateTime?
  completedAt DateTime?

  farm Farm @relation(fields: [farmId], references: [id])
  dco  User @relation("DcoAssignments", fields: [dcoUserId], references: [id])

  @@unique([farmId, dcoUserId])
  @@index([dcoUserId])
}
