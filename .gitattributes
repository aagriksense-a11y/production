# Normalize line endings across operating systems
* text=auto

# Keep source files on LF (used by Linux-backed CI/CD and Netlify builds)
*.js text eol=lf
*.mjs text eol=lf
*.ejs text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.prisma text eol=lf
*.html text eol=lf
*.py text eol=lf

# Binary files must never be converted
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary